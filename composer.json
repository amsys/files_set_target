{
    "name": "nextcloud/files_set_target",
    "description": "Define a custom target folder when sharing",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "nextcloud/coding-standard": "^1.0",
        "nextcloud/ocp": "^34.0",
        "nikic/php-parser": "^5.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "OCA\\SetTarget\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\SetTarget\\Tests\\": "tests/",
            "OCP\\": "vendor/nextcloud/ocp/OCP/",
            "NCU\\": "vendor/nextcloud/ocp/NCU/"
        }
    },
    "scripts": {
        "lint": "find . -name \\*.php -not -path './vendor/*' | xargs -r php -l",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "test": "phpunit -c phpunit.xml",
        "complexity": "phpunit -c phpunit.xml --filter CognitiveComplexity"
    }
}
