{
  "name": "files_set_target",
  "version": "1.0.0",
  "description": "Nextcloud app: define a custom target folder when sharing",
  "private": true,
  "scripts": {
    "build": "NODE_ENV=production webpack --config webpack.config.js",
    "dev": "NODE_ENV=development webpack --config webpack.config.js",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --watch",
    "lint": "eslint --ext .js src/ tests/js/",
    "test": "node --test tests/js/*.test.js",
    "lint:fix": "eslint --ext .js --fix src/ tests/js/"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.4.0",
    "@nextcloud/files": "^4.0.0",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.1.0",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/sharing": "^0.3.0"
  },
  "devDependencies": {
    "@nextcloud/eslint-config": "^8.4.1",
    "@nextcloud/webpack-vue-config": "^7.0.2",
    "eslint-plugin-sonarjs": "^0.25.1"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0",
    "npm": "^10.0.0 || ^11.0.0 || ^12.0.0"
  }
}
